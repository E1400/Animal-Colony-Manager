# Copy to .env and fill in. Never commit .env.

# --- Database ---------------------------------------------------------------
# Local development, no install required — start a throwaway Postgres with:
#   npx prisma dev -d -n colony
# and paste the URL it prints here.
#
# Production: the Neon *pooled* connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/postgres?sslmode=disable"

# --- Auth.js ----------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# GitHub OAuth App: GitHub Settings > Developer settings > OAuth Apps > New.
# Authorization callback URL:
#   local  http://localhost:3000/api/auth/callback/github
#   prod   https://<your-vercel-domain>/api/auth/callback/github
# GitHub allows one callback URL per app, so register two apps (dev + prod).
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
